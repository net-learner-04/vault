# Copy to .env and fill in real values:  cp .env.example .env

# --- App secrets (REQUIRED) ---
SECRET_KEY=change_me_to_a_long_random_string
RECOVERY_KEY=change_me_to_another_random_string
ADMIN_PASSWORD=change_me
ADMIN_EMAIL=admin@example.com

# --- Storage (Docker keeps these defaults) ---
DATABASE_URL=sqlite:////data/vault.db
UPLOAD_DIR=/data/uploads

# --- Email (SendGrid — only needed for password reset) ---
SENDGRID_API_KEY=
MAIL_FROM=noreply@example.com

# --- DuckDNS (used by docker-compose) ---
DUCKDNS_DOMAIN=vault.duckdns.org
DUCKDNS_SUBDOMAINS=vault
DUCKDNS_TOKEN=your_duckdns_token
TZ=Asia/Seoul
